# PowerShell: set process environment variables; the application does not auto-load .env.
# Docker Compose reads this file only after you copy it to .env.
C_ENV=development
C_ALLOW_LIVE=false
DATABASE_URL=sqlite:///c-prototype/work/application.sqlite3
REDIS_URL=
GRADING_ENDPOINT=
GRADING_MODEL=
GRADING_API_KEY=
GRADING_TIMEOUT=60
GRADING_MAX_TOKENS=2048
GRADING_THINKING=
GRADING_ALIGN_QUOTES=true
# For Compose only: set a unique local Postgres password before starting services.
POSTGRES_PASSWORD=
